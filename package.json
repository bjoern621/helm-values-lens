{
    "name": "helm-values-lens",
    "displayName": "Helm Values Lens",
    "description": "Shows where each Helm value gets set, which layer overrides it and the value that the chart renders with. Reads the value order from Argo CD Applications.",
    "version": "0.0.1",
    "publisher": "bjoern621",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "workspaceContains:**/*.yaml"
    ],
    "contributes": {
        "commands": [
            {
                "command": "helmValuesLens.showFinalValues",
                "title": "Show Final Values",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.showManifests",
                "title": "Show Rendered Manifests",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.render",
                "title": "Render Release",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.openChartFile",
                "title": "Open Chart File",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.refresh",
                "title": "Reload Releases",
                "category": "Helm Values Lens"
            }
        ],
        "configuration": {
            "title": "Helm Values Lens",
            "properties": {
                "helmValuesLens.helmPath": {
                    "type": "string",
                    "default": "helm",
                    "description": "The helm binary that pulls and renders the charts."
                },
                "helmValuesLens.renderOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Renders each release with helm template once the workspace opens and after each save of a YAML file."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "trace": "node esbuild.mjs && node dist/cli.js",
        "format": "prettier --write .",
        "vscode:prepublish": "npm run build",
        "package": "vsce package"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/vscode": "1.100.0",
        "@vscode/vsce": "4.1.0",
        "esbuild": "0.28.2",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "vitest": "4.1.0"
    },
    "dependencies": {
        "yaml": "2.9.1"
    }
}
