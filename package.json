{
    "name": "helm-values-lens",
    "displayName": "Helm Values Lens",
    "description": "Shows where each Helm value gets set, which layer overrides it and the value that the chart renders with. Reads the value order from Argo CD Applications.",
    "version": "1.0.0",
    "publisher": "bjoern621",
    "license": "MIT",
    "private": true,
    "engines": {
        "vscode": "^1.100.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "workspaceContains:**/*.yaml",
        "workspaceContains:**/*.yml",
        "workspaceContains:**/*.gotmpl",
        "workspaceContains:**/Kustomization"
    ],
    "contributes": {
        "commands": [
            {
                "command": "helmValuesLens.showFinalValues",
                "title": "Show Final Values",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.showManifests",
                "title": "Show Rendered Manifests",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.render",
                "title": "Render Release",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.openChartFile",
                "title": "Open Chart File",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.refresh",
                "title": "Reload Releases",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.selectRelease",
                "title": "Select Release for Hints",
                "category": "Helm Values Lens"
            },
            {
                "command": "helmValuesLens.addRelease",
                "title": "Add Release from a Chart and Values Files",
                "category": "Helm Values Lens"
            }
        ],
        "configuration": {
            "title": "Helm Values Lens",
            "properties": {
                "helmValuesLens.helmPath": {
                    "type": "string",
                    "default": "helm",
                    "description": "The helm binary that pulls and renders the charts."
                },
                "helmValuesLens.renderOnSave": {
                    "type": "boolean",
                    "default": true,
                    "description": "Renders each release with helm template once the workspace opens and after each save of a YAML file."
                },
                "helmValuesLens.hover.showAllLayers": {
                    "type": "boolean",
                    "default": true,
                    "description": "Lists every values layer of the release in the hover, the ones that leave the key alone included."
                },
                "helmValuesLens.releases": {
                    "type": "array",
                    "default": [],
                    "markdownDescription": "Releases that no Argo CD, Helmfile, Flux or Kustomize file describes. Each takes a chart folder and its values files in the order that Helm merges them, the last one winning. Paths are relative to the first workspace folder. The command `Helm Values Lens: Add Release from a Chart and Values Files` adds one.",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "chart"
                        ],
                        "additionalProperties": false,
                        "properties": {
                            "name": {
                                "type": "string",
                                "description": "Name shown in the hints."
                            },
                            "chart": {
                                "type": "string",
                                "description": "Chart folder, relative to the first workspace folder."
                            },
                            "valueFiles": {
                                "type": "array",
                                "items": {
                                    "type": "string"
                                },
                                "description": "Values files, lowest first, relative to the first workspace folder."
                            },
                            "set": {
                                "type": "object",
                                "additionalProperties": {
                                    "type": [
                                        "string",
                                        "number",
                                        "boolean"
                                    ]
                                },
                                "description": "Values as --set passes them, keyed by their dotted path."
                            },
                            "namespace": {
                                "type": "string"
                            },
                            "releaseName": {
                                "type": "string",
                                "description": "Release name that the templates read as .Release.Name. Defaults to name."
                            }
                        }
                    }
                },
                "helmValuesLens.repositories": {
                    "type": "object",
                    "default": {},
                    "additionalProperties": {
                        "type": "string"
                    },
                    "markdownDescription": "Repository URLs mapped to folders, relative to the first workspace folder. Needed for a repository whose checkout has no remote with that URL and whose folder path does not end with the path of the URL. Example: `{ \"https://git.example.com/acme/gitops.git\": \"gitops\" }`."
                }
            }
        }
    },
    "scripts": {
        "build": "node esbuild.mjs",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "trace": "node esbuild.mjs && node dist/cli.js",
        "format": "prettier --write .",
        "vscode:prepublish": "npm run build",
        "package": "vsce package --no-rewrite-relative-links"
    },
    "devDependencies": {
        "@types/node": "22.20.5",
        "@types/vscode": "1.100.0",
        "@vscode/vsce": "4.1.0",
        "esbuild": "0.28.2",
        "prettier": "3.10.1",
        "typescript": "5.9.3",
        "vitest": "4.1.0"
    },
    "dependencies": {
        "yaml": "2.9.1"
    }
}
