{
    "$schema": "https://json-schema.org/draft-07/schema#",
    "type": "object",
    "properties": {
        "replicas": {
            "description": "How many pods the Deployment runs.",
            "type": "integer",
            "minimum": 1
        },
        "image": {
            "type": "object",
            "properties": {
                "repository": { "type": "string" },
                "tag": { "description": "The image tag, quoted so that YAML keeps it a string.", "type": "string" },
                "pullPolicy": {
                    "description": "When the kubelet pulls the image.",
                    "enum": ["Always", "IfNotPresent", "Never"]
                }
            }
        },
        "resources": { "$ref": "#/definitions/resources" }
    },
    "definitions": {
        "resources": {
            "type": "object",
            "properties": {
                "limits": { "type": "object" },
                "requests": { "type": "object" }
            }
        }
    }
}
